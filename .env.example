# Copie para .env e ajuste. O .env nunca deve ser compartilhado nem ir para o Git.
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=erp
DB_PASSWORD=erp123
DB_NAME=erp

# Chave que assina as sessões. Gere uma com "npm run segredo" e cole aqui (mínimo 32 caracteres).
JWT_SECRET=
# Duração da sessão, em horas
SESSAO_HORAS=8

# Em produção, com o sistema atrás de https://, use HTTPS=true (cookie seguro + HSTS)
HTTPS=false
# Quantos proxies (nginx etc.) existem na frente do Node. Sem proxy, deixe 0.
TRUST_PROXY=0
# Pasta onde ficam os anexos (editais, planilhas, certidões). Inclua no backup.
STORAGE_DIR=./storage

# Usado só pelo "npm run seed" para criar o primeiro acesso. Troque a senha antes de rodar
# (mínimo 8 caracteres, com letras e números) e apague-a daqui depois do primeiro login.
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@exemplo.com
ADMIN_SENHA=trocar123
EMPRESA_RAZAO_SOCIAL=Construtora Exemplo Ltda
EMPRESA_CNPJ=00000000000191
